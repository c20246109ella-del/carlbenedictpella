---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

const name = "Carl Benedict P. Ella";
const position = "AI Engineer";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
	
		<title>{name} | {position}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased">
		<div
			class="pointer-events-none fixed inset-x-0 top-0 z-50 h-1 origin-left bg-cyan-400"
			style="transform: scaleX(0)"
			role="progressbar"
			aria-label="Page reading progress"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow="0"
			data-scroll-progress
		></div>
		<Header />
		<main>
		<slot />
		</main>
		<Footer />
		<script>
			import "../scripts/animation.js"
		</script>
            <script>
            import { FallingLeaves } from "falling-leaves";

           new FallingLeaves({ shapes: ["maple", "oak", "ginkgo", "birch", "oval"] });
        </script> 
	</body>
</html>
